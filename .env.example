# Copy to .env for local overrides. Never commit .env.
# The Streamlit demo does not need these. The API and Compose path do.

# API
DEUCE_API_HOST=127.0.0.1
DEUCE_API_PORT=8000
DEUCE_API_RELOAD=0

# Product database. Unset uses local SQLite under DEUCE_DATA_DIR.
# Compose sets this to Postgres for the api service.
# DEUCE_DB_URL=postgresql+psycopg://deuce:deuce@localhost:5432/deuce
DEUCE_DATA_DIR=.deuce
# SQLite creates tables on startup. Postgres uses Alembic. Set 1 to force create_all.
# DEUCE_DB_AUTO_CREATE=0

# Live-score scrapers are off on the product path unless this is 1.
DEUCE_LIVE_SCORES_ENABLED=0
# Used only when DEUCE_LIVE_SCORES_ENABLED=1.
DEUCE_LIVE_SCORE_PROVIDER=auto

# Model bundle. Defaults to artifacts/demo/tennis_model_core.pkl.
# DEUCE_MODEL_PATH=
# DEUCE_PLAYER_DB=data/player_stats.json
# DEUCE_TOURNAMENT_CATALOG=data/tournament_catalog.json

# Historical import. The scheduler inside the API stays off unless ENABLED=1.
DEUCE_IMPORT_ENABLED=0
DEUCE_IMPORT_ON_START=1
DEUCE_IMPORT_INTERVAL_MINUTES=1440
DEUCE_IMPORT_ADAPTER=local_csv
DEUCE_IMPORT_SOURCE=data/demo/demo_matches.csv
# block: error-level DQ failures write no match rows.
# flag: valid rows load, bad rows are skipped, and the run is marked flagged.
DEUCE_DQ_MODE=block
DEUCE_DQ_DATE_MIN=1990-01-01
DEUCE_DQ_DATE_MAX=2035-12-31

# Local Compose Postgres bootstrap. Override these outside the repo for anything shared.
POSTGRES_USER=deuce
POSTGRES_PASSWORD=deuce
POSTGRES_DB=deuce
POSTGRES_PORT=5432
